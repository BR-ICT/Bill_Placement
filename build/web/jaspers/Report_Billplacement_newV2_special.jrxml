	<parameter name="cono" class="java.lang.String"/>
	<parameter name="startdate" class="java.lang.String"/>
	<parameter name="enddate" class="java.lang.String"/>
	<parameter name="divi" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT BPM_TYPE,OKCUNO,trim(OKCUNM) as OKCUNM,BPM_RINV,OKCFC3,BPM_BILDESC,BPM_COLDESC,OKSMCD,OKPYCD,BPM_COLBY,BPM_REMARK
FROM BRLDTA0100.BP_MASTER master
LEFT JOIN M3FDBPRD.OCUSMA customer ON  CUSTOMER.OKCONO = master.BPM_CONO  AND CUSTOMER.OKCUNO = master.BPM_CUNO 
WHERE (master.BPM_RINV <> 7 AND master.BPM_RINV <> 15 AND master.BPM_RINV <> 30)
AND master.BPM_CONO =  $P{cono}
AND master.BPM_DIVI = $P{divi}
ORDER BY OKCUNO]]>
	</queryString>
